# ── AI Video Assistant Environment Configuration ──

# 1. Mistral API Key (Required for Summarization, Key Insights, Action Items & Chat)
#    Get your free API key at: https://console.mistral.ai/
MISTRAL_API_KEY=

# 2. Sarvam API Key (Optional — only required if selecting "hinglish" language mode)
#    Get your key at: https://www.sarvam.ai/
SARVAM_API_KEY=

# 3. Whisper Model (Default: "base" — recommended for fast CPU transcription)
#    Options: tiny, base, small, medium, large
WHISPER_MODEL=base
